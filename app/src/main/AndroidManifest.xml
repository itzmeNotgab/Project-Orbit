<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network: used only for ORBIT account sign-in/sync. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required on Android 11+ to see whether Minecraft is installed. -->
    <queries><package android:name="com.mojang.minecraftpe" /></queries>
    <application
        android:name=".OrbitApplication"
        android:label="ORBIT"
        android:allowBackup="false"
        android:theme="@style/Theme.Orbit">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files" android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
